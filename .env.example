# ===================================================================
# FarmConnect AI Environment Configuration Example
# Copy this file to .env or set these environment variables locally
# ===================================================================

# Database Credentials
DB_URL=jdbc:mysql://localhost:3306/farmconnect_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Market Data API (Optional external key for Data.gov.in Mandi prices)
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_API_KEY=your_api_key_here

# Initial Admin User Credentials
CREATE_INITIAL_ADMIN=true
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@farmconnect.ai
INITIAL_ADMIN_MOBILE=9876543210
INITIAL_ADMIN_PASSWORD=Admin@FarmConnect2026

# Server Port
SERVER_PORT=8080
